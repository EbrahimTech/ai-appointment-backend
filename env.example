# ============================================
# AI Appointment Backend - Environment Variables
# ============================================
# 
# نسخ هذا الملف إلى .env واملأ القيم المطلوبة
# cp env.example .env
# أو على Windows: copy env.example .env
#
# ملاحظة: لا تشارك ملف .env أبداً - يحتوي على معلومات حساسة
# ============================================

# ============================================
# Django Core Settings
# ============================================
# Secret key للـ Django - يجب أن يكون قوياً وفريداً
# توليد: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production

# وضع التطوير - يجب أن يكون false في production
# true = وضع التطوير (يعرض أخطاء مفصلة)
# false = وضع الإنتاج (آمن)
DJANGO_DEBUG=false

# قائمة الـ domains المسموح بها (مفصولة بفواصل)
# في production: yourdomain.com,www.yourdomain.com
# في development: localhost,127.0.0.1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ============================================
# Database (PostgreSQL)
# ============================================
# اسم قاعدة البيانات
POSTGRES_DB=ai_appointment

# اسم المستخدم لقاعدة البيانات
POSTGRES_USER=ai_user

# كلمة مرور قوية لقاعدة البيانات (16+ حرف، أرقام، رموز)
POSTGRES_PASSWORD=your-strong-database-password

# عنوان قاعدة البيانات
# في Docker: db
# في local: localhost
POSTGRES_HOST=db

# منفذ قاعدة البيانات
POSTGRES_PORT=5432

# ============================================
# Redis (للـ Celery)
# ============================================
# كلمة مرور قوية لـ Redis (16+ حرف، أرقام، رموز)
REDIS_PASSWORD=your-strong-redis-password

# URL للـ Celery Broker (يستخدم Redis)
# في Docker: redis://:${REDIS_PASSWORD}@redis:6379/0
# في local: redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# URL للـ Celery Result Backend (يستخدم Redis)
CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@redis:6379/0

# ============================================
# Security & Encryption
# ============================================
# مفتاح التشفير - يجب أن يكون قوياً (32 bytes hex)
# توليد: python -c "import secrets; print(secrets.token_hex(32))"
ENCRYPTION_KEY=your-encryption-key-here-change-in-production

# Secret للـ webhooks الخارجية
# توليد: python -c "import secrets; print(secrets.token_urlsafe(32))"
LEAD_WEBHOOK_SECRET=your-webhook-secret-here-change-in-production

# ============================================
# JWT Authentication
# ============================================
# مدة صلاحية Access Token (بالدقائق)
JWT_ACCESS_LIFETIME_MINUTES=30

# مدة صلاحية Refresh Token (بالأيام)
JWT_REFRESH_LIFETIME_DAYS=7

# ============================================
# Support Sessions (HQ Staff)
# ============================================
# مدة جلسة الدعم بالدقائق (HQ staff يمكنهم الدخول كعيادة مؤقتاً)
SUPPORT_SESSION_MINUTES=60

# ============================================
# LLM (DeepSeek) - اختياري
# ============================================
# API Key من DeepSeek
# احصل عليه من: https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# Base URL لـ DeepSeek API
DEEPSEEK_API_BASE=https://api.deepseek.com

# ============================================
# LLM Advanced Settings - اختياري
# ============================================
# مهلة انتظار الـ LLM بالثواني
LLM_TIMEOUT_SECONDS=15

# النموذج الافتراضي للـ LLM
LLM_DEFAULT_MODEL=deepseek-chat

# اسم فهرس RAG
RAG_INDEX_NAME=default

# عدد النتائج من RAG
RAG_TOP_K=4

# أقصى latency للـ LLM بالمللي ثانية
LLM_MAX_LATENCY_MS=12000

# ميزانية التكلفة اليومية للـ LLM (0 = غير محدود)
LLM_COST_BUDGET_PER_DAY=0

# التكلفة لكل طلب LLM
LLM_COST_PER_REQUEST=0.002

# اسم القالب الافتراضي عند فشل LLM
LLM_FALLBACK_TEMPLATE_NAME=session_clarify

# أقصى tokens من RAG
RAG_MAX_TOKENS=1000

# عدد الأحرف لكل token (تقريبي)
RAG_CHARS_PER_TOKEN=4

# ============================================
# Google Calendar OAuth - اختياري
# ============================================
# Client ID من Google Cloud Console
# احصل عليه من: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=

# Client Secret من Google Cloud Console
GOOGLE_CLIENT_SECRET=

# Redirect URI بعد OAuth
# في production: https://yourdomain.com/calendars/google/callback
# في development: http://localhost:8000/calendars/google/callback
GOOGLE_REDIRECT_URI=

# ============================================
# WhatsApp Integration - اختياري
# ============================================
# رقم WhatsApp الافتراضي للمرسل
# مثال: +1234567890
WHATSAPP_DEFAULT_SENDER=

# اسم HSM الافتراضي عند فشل الجلسة
WHATSAPP_SESSION_FALLBACK_HSM_NAME=session_clarify

# ============================================
# WhatsApp Test Mode - للاختبار فقط
# ============================================
# قائمة الأرقام المسموح بها في test mode (JSON)
# مثال: {"demo-dental":["+15555550123"],"*":["+15555550999"]}
# "*" = جميع العيادات
WHATSAPP_TEST_ALLOWLIST=

# معدل الرسائل في test mode (رسائل في الدقيقة)
WHATSAPP_TEST_RPM=3

# ============================================
# Celery Settings
# ============================================
# عدد الثواني بين محاولات sync Google Calendar للمواعيد المؤقتة
CELERY_SWEEP_TENTATIVE_SECONDS=600

# ============================================
# Data Retention
# ============================================
# عدد الأيام قبل حذف/إخفاء البيانات الحساسة
DATA_RETENTION_DAYS=30

# ============================================
# Frontend (Next.js)
# ============================================
# URL للـ Backend API
# في production: https://yourdomain.com
# في development: http://localhost:8000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# المنطقة الزمنية الافتراضية
NEXT_PUBLIC_DEFAULT_TZ=UTC

# ============================================
# CORS (Cross-Origin Resource Sharing)
# ============================================
# قائمة الـ origins المسموح بها (مفصولة بفواصل)
# في production: https://yourdomain.com,https://www.yourdomain.com
# في development: http://localhost:3000
CORS_ALLOWED_ORIGINS=

# ============================================
# SSL/HTTPS (Production Only)
# ============================================
# إعادة توجيه HTTP إلى HTTPS تلقائياً
# في production: true
# في development: false
SECURE_SSL_REDIRECT=true

# ============================================
# ملاحظات مهمة:
# ============================================
# 1. جميع القيم التي تحتوي على "change-in-production" يجب تغييرها
# 2. Secrets يجب أن تكون قوية وفريدة
# 3. في production، استخدم DJANGO_DEBUG=false دائماً
# 4. لا تشارك ملف .env أبداً
# 5. المتغيرات الاختيارية يمكن تركها فارغة إذا لم تكن مطلوبة
# 6. للتوليد السريع للـ secrets:
#    - DJANGO_SECRET_KEY: python -c "import secrets; print(secrets.token_urlsafe(50))"
#    - ENCRYPTION_KEY: python -c "import secrets; print(secrets.token_hex(32))"
#    - LEAD_WEBHOOK_SECRET: python -c "import secrets; print(secrets.token_urlsafe(32))"

