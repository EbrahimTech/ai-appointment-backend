# ============================================
# AI Appointment Backend - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control!

# ============================================
# Django Core Settings
# ============================================
DJANGO_SECRET_KEY=change-this-to-a-strong-random-secret-key-min-50-chars
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com,api.yourdomain.com
ENCRYPTION_KEY=change-this-to-a-strong-encryption-key-min-32-chars

# ============================================
# Database Configuration
# ============================================
POSTGRES_DB=ai_appointment
POSTGRES_USER=ai_user
POSTGRES_PASSWORD=change-this-strong-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ============================================
# Celery/Redis Configuration
# ============================================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_SWEEP_TENTATIVE_SECONDS=600

# ============================================
# WhatsApp Integration
# ============================================
# For Meta/Facebook: Phone Number ID
# For Twilio: WhatsApp number (e.g., whatsapp:+14155238886)
WHATSAPP_DEFAULT_SENDER=
WHATSAPP_API_KEY=
WHATSAPP_API_URL=
WHATSAPP_TEST_MODE=false
WHATSAPP_TEST_ALLOWLIST={"demo-dental":["+15555550123"],"*":["+15555550999"]}
WHATSAPP_TEST_RPM=3
WHATSAPP_SESSION_WINDOW_HOURS=24
WHATSAPP_MAX_INITIAL_DELAY_SECONDS=10
WHATSAPP_SESSION_FALLBACK_HSM_NAME=session_clarify

# ============================================
# Google Calendar Integration
# ============================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://yourdomain.com/api/calendars/google/callback
GOOGLE_CALENDAR_ID=primary

# ============================================
# DeepSeek LLM Configuration
# ============================================
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
LLM_DEFAULT_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=15
LLM_MAX_LATENCY_MS=12000
LLM_COST_BUDGET_PER_DAY=0
LLM_COST_PER_REQUEST=0.002
LLM_FALLBACK_TEMPLATE_NAME=session_clarify

# ============================================
# RAG Configuration
# ============================================
RAG_INDEX_NAME=default
RAG_TOP_K=4
RAG_MAX_TOKENS=1000
RAG_CHARS_PER_TOKEN=4

# ============================================
# Webhooks
# ============================================
LEAD_WEBHOOK_SECRET=change-this-to-a-strong-webhook-secret

# ============================================
# JWT Configuration
# ============================================
JWT_ACCESS_LIFETIME_MINUTES=30
JWT_REFRESH_LIFETIME_DAYS=7

# ============================================
# Support Sessions
# ============================================
SUPPORT_SESSION_MINUTES=15

# ============================================
# Data Retention
# ============================================
DATA_RETENTION_DAYS=30

# ============================================
# Outbox Configuration
# ============================================
OUTBOX_DISPATCH_BATCH_SIZE=50
OUTBOX_BACKOFF_MAX_SECONDS=300
OUTBOX_MAX_ATTEMPTS=5

# ============================================
# Google Calendar Sync
# ============================================
GOOGLE_SYNC_MAX_ATTEMPTS=5
GOOGLE_SYNC_INITIAL_DELAY=60
GOOGLE_SYNC_MAX_DELAY=1800
GOOGLE_SYNC_CACHE_SECONDS=120
GOOGLE_SYNC_SWEEP_BATCH=25

# ============================================
# Security (Production Only)
# ============================================
SECURE_SSL_REDIRECT=true

# ============================================
# CORS (if needed)
# ============================================
CORS_ALLOWED_ORIGINS=

# ============================================
# Frontend
# ============================================
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# ============================================
# Gunicorn (Production)
# ============================================
GUNICORN_WORKERS=4
GUNICORN_LOG_LEVEL=info
PORT=8000

